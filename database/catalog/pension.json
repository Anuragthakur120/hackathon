{
  "id": "pension",
  "code": "IGNOAPS-MH-01",
  "department": {
    "mr": "सामाजिक न्याय व विशेष सहाय्य विभाग (Social Justice Dept)",
    "hi": "सामाजिक न्याय एवं विशेष सहायता विभाग (Social Justice Dept)",
    "en": "Department of Social Justice and Special Assistance"
  },
  "name": {
    "mr": "इंदिरा गांधी राष्ट्रीय वृद्धापकाळ / विधवा पेन्शन योजना",
    "hi": "इंदिरा गांधी राष्ट्रीय वृद्धावस्था / विधवा पेंशन योजना",
    "en": "Indira Gandhi National Old Age / Widow Pension Scheme"
  },
  "description": {
    "mr": "वृद्ध आणि विधवा नागरिकांसाठी मासिक निवृत्तीवेतन सुरू करणे किंवा थांबलेले पेन्शन पुन्हा चालू करणे.",
    "hi": "वरिष्ठ और विधवा नागरिकों के लिए मासिक पेंशन शुरू करना या रुकी हुई पेंशन फिर से चालू करना।",
    "en": "Start or restart monthly pension for elderly and widow citizens."
  },
  "fields": [
    {
      "key": "full_name",
      "source": "PROFILE",
      "profile_key": "fullName",
      "label": {
        "mr": "पूर्ण नाव",
        "hi": "पूरा नाम",
        "en": "Full Name"
      },
      "sensitive": false,
      "type": "string",
      "required": true
    },
    {
      "key": "dob",
      "source": "PROFILE",
      "profile_key": "dob",
      "label": {
        "mr": "जन्मतारीख",
        "hi": "जन्म तिथि",
        "en": "Date of Birth"
      },
      "sensitive": false,
      "type": "date",
      "required": true
    },
    {
      "key": "age_years",
      "source": "DERIVED",
      "derive_from": "dob",
      "label": {
        "mr": "वय (वर्षे)",
        "hi": "आयु (वर्ष)",
        "en": "Age (Years)"
      },
      "sensitive": false,
      "type": "number",
      "required": true
    },
    {
      "key": "gender",
      "source": "PROFILE",
      "profile_key": "gender",
      "label": {
        "mr": "लिंग",
        "hi": "लिंग",
        "en": "Gender"
      },
      "sensitive": false,
      "type": "enum",
      "options": ["Female", "Male", "Other"],
      "required": true
    },
    {
      "key": "pension_subtype",
      "source": "ASK_CITIZEN",
      "label": {
        "mr": "पेन्शन प्रकार (वृद्धापकाळ / विधवा)",
        "hi": "पेंशन प्रकार (वृद्धावस्था / विधवा)",
        "en": "Pension Subtype (Old Age / Widow)"
      },
      "sensitive": false,
      "type": "enum",
      "options": ["old_age_pension", "widow_pension"],
      "required": true
    },
    {
      "key": "aadhaar_masked",
