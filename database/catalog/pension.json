    {
      "key": "address",
      "source": "PROFILE",
      "profile_key": "address",
      "label": {
        "mr": "निवासी पत्ता",
        "hi": "निवास का पता",
        "en": "Residential Address"
      },
      "sensitive": false,
      "type": "string",
      "required": true
    },
    {
      "key": "district",
      "source": "PROFILE",
      "profile_key": "district",
      "label": {
        "mr": "जिल्हा",
        "hi": "जिला",
        "en": "District"
      },
      "sensitive": false,
      "type": "string",
      "required": true
    },
    {
      "key": "bank_account_masked",
      "source": "DOCUMENT",
      "document_key": "bank_passbook",
      "label": {
        "mr": "बँक खाते क्रमांक (मास्क केलेला)",
        "hi": "बैंक खाता संख्या (मास्क किया गया)",
        "en": "Bank Account Number (Masked)"
      },
      "sensitive": true,
      "type": "string",
      "required": true
