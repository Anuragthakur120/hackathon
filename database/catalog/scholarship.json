    { "step": 16, "status": "CLOSED", "phase": "PEECHA_KARNA", "label": { "mr": "शिष्यवृत्ती मंजूर (प्रकरण पूर्ण)", "hi": "छात्रवृत्ति स्वीकृत (केस पूर्ण)", "en": "Scholarship Sanctioned (Case Closed)" } }
